From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: bot-for-go[bot] <199222863+bot-for-go[bot]@users.noreply.github.com>
Date: Fri, 11 Feb 2022 18:07:18 -0600
Subject: [PATCH] Add Azure Linux, FIPS, package upgrade

---
 Dockerfile-linux.template | 105 +++++++++++++++++++++++++++++++++++++-
 1 file changed, 104 insertions(+), 1 deletion(-)

diff --git a/Dockerfile-linux.template b/Dockerfile-linux.template
index 603f1e33d2f51a..9fdc1986aa25cc 100644
--- a/Dockerfile-linux.template
+++ b/Dockerfile-linux.template
@@ -4,9 +4,40 @@
 	;
 	def alpine_version:
 		env.variant | ltrimstr("alpine")
+	;
+	def is_azurelinux_2:
+		env.variant | startswith("cbl-mariner")
+	;
+	def is_azurelinux:
+		(env.variant | startswith("azurelinux")) or is_azurelinux_2
+	;
+	def azurelinux_version:
+		env.variant | ltrimstr("cbl-mariner") | ltrimstr("azurelinux")
+	;
+	def azurelinux_repo:
+		if is_azurelinux_2 then ("cbl-mariner") else ("azurelinux") end
+	;
+
+	def is_fips:
+		(.branchSuffix // "") | contains("fips")
 -}}
 {{ if is_alpine then ( -}}
 FROM alpine:{{ alpine_version }} AS build
+{{ ) elif is_azurelinux then ( -}}
+FROM mcr.microsoft.com/{{ azurelinux_repo }}/base/core:{{ azurelinux_version }} AS build
+
+# Dependencies needed to get the Go tarball. We never build Go from source in this Dockerfile.
+RUN set -eux; \
+# Upgrade all packages per https://eng.ms/docs/more/containers-secure-supply-chain/updating
+	tdnf update -y; \
+	tdnf install -y \
+		tar \
+		wget \
+		# To reduce image size, the Azure Linux (aka CBL-Mariner) image doesn't include full ca-certificates: https://github.com/microsoft/azurelinux/issues/3563
+		# We need ca-certificates here to verify https://download.visualstudio.microsoft.com.
+		ca-certificates \
+	; \
+	tdnf clean all
 {{ ) else ( -}}
 FROM buildpack-deps:{{ env.variant }}-scm AS build
 {{ ) end -}}
@@ -38,6 +69,13 @@ ENV GOLANG_COMMIT $GOLANG_COMMIT
 				riscv64: "riscv64",
 				s390x: "s390x",
 			}
+		elif is_azurelinux then
+			{
+				amd64: "x86_64",
+				arm32v6: "armhf",
+				arm32v7: "armv7",
+				arm64v8: "aarch64",
+			}
 		else
 			{
 				# https://salsa.debian.org/dpkg-team/dpkg/-/blob/main/data/cputable
@@ -73,6 +111,8 @@ RUN set -eux; \
 {{ ) end -}}
 	; \
 	arch="$(apk --print-arch)"; \
+{{ ) elif is_azurelinux then ( -}}
+	arch="$(uname -m)"; \
 {{ ) else ( -}}
 	arch="$(dpkg --print-architecture)"; arch="${arch##*-}"; \
 {{ ) end -}}
@@ -111,7 +151,11 @@ RUN set -eux; \
 	\
 {{ if env.version != "tip" then ( -}}
 	wget -O go.tgz.asc "$urlSig"; \
-	wget -O go.tgz "$url"{{ if is_alpine then "" else " --progress=dot:giga" end }}; \
+{{ if is_azurelinux then ( -}}
+# GNU Wget2 used by Azure Linux 3.0 no longer supports "--progress=dot:giga" and errors out. https://github.com/rockdaboot/wget2/issues/317
+# We don't use it for any Azure Linux version for simplicity. (It worked in Azure Linux 2.0.)
+{{ ) else ("") end -}}
+	wget -O go.tgz "$url"{{ if (is_alpine or is_azurelinux) then "" else " --progress=dot:giga" end }}; \
 	echo "$sha256 *go.tgz" | sha256sum -c -; \
 	\
 # https://github.com/golang/go/issues/14739#issuecomment-324767697
@@ -143,10 +187,16 @@ RUN set -eux; \
 	gpg --batch --show-keys --with-colons microsoft-managed-lang-compiler.asc \
 		| grep -q '^uid:.*:Managed Languages Compiler Dev Team <mlangcompdev@microsoft.com>:'; \
 	gpg --batch --import microsoft-managed-lang-compiler.asc; \
+{{ if is_azurelinux then ( -}}
+# Azure Linux doesn't include dirmngr, which is required for keyserver import. Skipping keyserver
+# import. In microsoft/go-images, we use a manually imported key anyway.
+# See https://microsoft.visualstudio.com/OS/_workitems/edit/62225284
+{{ ) else ( -}}
 # https://www.google.com/linuxrepositories/
 	gpg --batch --keyserver keyserver.ubuntu.com --recv-keys 'EB4C 1BFD 4F04 2F6D DDCC  EC91 7721 F63B D38B 4796'; \
 # let's also fetch the specific subkey of that key explicitly that we expect "go.tgz.asc" to be signed by, just to make sure we definitely have it
 	gpg --batch --keyserver keyserver.ubuntu.com --recv-keys '2F52 8D36 D67B 69ED F998  D857 78BD 6547 3CB3 BD13'; \
+{{ ) end -}}
 	gpg --batch --verify go.tgz.asc go.tgz; \
 	gpgconf --kill all; \
 	rm -rf "$GNUPGHOME" go.tgz.asc; \
@@ -241,18 +291,71 @@ RUN set -eux; \
 FROM alpine:{{ alpine_version }}
 
 RUN apk add --no-cache ca-certificates
+{{ ) elif is_azurelinux then ( -}}
+FROM mcr.microsoft.com/{{ azurelinux_repo }}/base/core:{{ azurelinux_version }}
+
+RUN set -eux; \
+# Upgrade all packages per https://eng.ms/docs/more/containers-secure-supply-chain/updating
+	tdnf update -y; \
+	tdnf install -y \
+		binutils \
+		gcc \
+		glibc \
+		glibc-devel \
+		iana-etc \
+		kernel-headers \
+		tar \
+		wget \
+		\
+		# To reduce image size, the Azure Linux (aka CBL-Mariner) image doesn't include full ca-certificates: https://github.com/microsoft/azurelinux/issues/3563
+		# Full certs are expected in a builder-style image (e.g., to fetch dependencies), so we need to install them.
+		ca-certificates \
+		\
+		# Each of the following packages need to be installed for one or both of these reasons:
+		# - Azure Pipelines specifies it as a requirement to use an image in container jobs: https://learn.microsoft.com/en-us/azure/devops/pipelines/process/container-phases?view=azure-devops
+		# - The package is included in the Debian-based golang image, so installing it here improves compatibility.
+		#
+		# These packages don't need to be installed in a Debian golang Dockerfile because they are included by default in its base image: https://hub.docker.com/_/buildpack-deps/
+		# The mcr.microsoft.com/cbl-mariner/base/core images are optimized for size to make them suitable for deployment, so many development tools aren't included.
+		# There isn't a buildpack-deps analog for Azure Linux: https://github.com/microsoft/azurelinux/issues/8964 (https://devdiv.visualstudio.com/DevDiv/_workitems/edit/2055698)
+		git \
+		make \
+		shadow-utils \
+		util-linux \
+		which \
+{{
+	if is_fips then (
+-}}
+		# Install OpenSSL for headers when building a FIPS-compatible app with Go.
+		openssl-devel \
+{{
+	) else "" end
+-}}
+	; \
+	tdnf clean all
+
 {{ ) else ( -}}
 FROM buildpack-deps:{{ env.variant }}-scm
 
 # install cgo-related dependencies
 RUN set -eux; \
 	apt-get update; \
+# Upgrade all packages per https://eng.ms/docs/more/containers-secure-supply-chain/updating
+	apt-get upgrade -y; \
 	apt-get install -y --no-install-recommends \
 		g++ \
 		gcc \
 		libc6-dev \
 		make \
 		pkg-config \
+{{
+	if is_fips then (
+-}}
+		# Install OpenSSL for headers when building a FIPS-compatible app with Go.
+		libssl-dev \
+{{
+	) else "" end
+-}}
 	; \
 # go depends on "gold" explicitly on arm64
 # https://github.com/docker-library/golang/issues/570 (go depends on "gold" explicitly on arm64)
